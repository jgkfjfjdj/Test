{
  "name": "@kindling/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema (Drizzle ORM), SQL migrations and database helpers.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/cli/migrate.ts",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@kindling/contracts": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "vitest": "^5.1.0"
  }
}
