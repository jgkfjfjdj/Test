<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same test sources the Unity Test Runner compiles (EditMode/Pure). -->
    <Compile Include="$(GameTests)/EditMode/Pure/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- NUnit 3.x keeps the API compatible with Unity's bundled NUnit. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Kindling.Sim/Kindling.Sim.csproj" />
  </ItemGroup>
</Project>
