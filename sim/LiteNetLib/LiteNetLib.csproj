<Project Sdk="Microsoft.NET.Sdk">
  <!-- Vendored LiteNetLib source (MIT), compiled from the Unity project's ThirdParty folder. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LiteNetLib</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Third-party code: don't fail the build on its warnings. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0618;CS1591;CS8632;CS0162;CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <!--
    LiteNetLib only simulates latency/loss when compiled with DEBUG. Load tests build with
    -p:LiteNetSimulation=true to get it in an otherwise optimized Release build.
  -->
  <PropertyGroup Condition="'$(LiteNetSimulation)' == 'true'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../game/Assets/ThirdParty/LiteNetLib/**/*.cs" />
  </ItemGroup>
</Project>
