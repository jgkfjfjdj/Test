# Copy to .env for local development (never commit .env).
NODE_ENV=development
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=debug
DATABASE_URL=postgres://kindling:kindling@localhost:5432/kindling
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=http://localhost:8080

# Signing keys and secrets: leave empty in development (ephemeral keys / public dev secrets are used
# and a warning is logged). Production refuses to start without them. Generate keys with:
#   pnpm --filter @kindling/api keys:generate
ACCESS_TOKEN_KEYS=
TICKET_KEYS=
IP_HASH_SECRET=
STAFF_SECRET_KEY=

# Sign in with Apple: your iOS bundle id(s), comma-separated.
APPLE_CLIENT_IDS=com.example.kindling

# Email: "log" keeps messages in memory and logs a line; "smtp" sends them.
# Local SMTP catcher: docker compose -f infra/compose/docker-compose.dev.yml --profile mail up -d
# then MAIL_TRANSPORT=smtp and SMTP_URL=smtp://localhost:1025 (web inbox: http://localhost:8025).
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=KINDLING <no-reply@kindling.invalid>

# Staff console cookies need HTTPS unless this is false (local http only).
ADMIN_COOKIE_SECURE=false

# Integration tests use separate databases so they never touch dev data.
TEST_DATABASE_URL=postgres://kindling:kindling@localhost:5432/kindling_test
TEST_REDIS_URL=redis://localhost:6379/15
