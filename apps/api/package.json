{
  "name": "@kindling/api",
  "version": "0.1.0",
  "private": true,
  "description": "KINDLING backend API: REST + WebSockets (Fastify).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "openapi": "tsx scripts/export-openapi.ts",
    "staff:invite": "tsx --env-file-if-exists=../../.env scripts/staff-invite.ts",
    "accounts:purge": "tsx --env-file-if-exists=../../.env scripts/purge-accounts.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/websocket": "^11.3.7",
    "@kindling/contracts": "workspace:*",
    "@kindling/db": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "typebox": "^1.4.5",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.21.0",
    "vitest": "^5.1.0"
  }
}
