{
  "name": "@kindling/web",
  "version": "0.1.0",
  "private": true,
  "description": "KINDLING staff console (React SPA served by the API under /admin).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "echo 'web: end-to-end tests run with pnpm --filter @kindling/web e2e'",
    "e2e": "playwright test",
    "api:types": "openapi-typescript ../../docs/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
